# Reference only: this project does NOT automatically load .env files.
# Windows users: double-click start.bat and answer the prompts instead.
# Never commit real values or copy this example into frontend/VITE_* settings.

# Obtain these four values from the owner of the existing Neon database.
PGHOST=example-neon-host.invalid
PGDATABASE=example_database
PGUSER=example_role
PGPASSWORD=
PGPORT=5432
PGSSLMODE=require
PGCHANNELBINDING=require
PGCONNECT_TIMEOUT=15

# Optional: required only to start new AI analyses.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional local ports. Keep them different.
PORT=5173
API_PORT=8000
